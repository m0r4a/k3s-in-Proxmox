# Example of the fragment written by the cluster root (terraform/cluster).
# The real file is inventory.d/10-cluster.ini (generated, gitignored).
# Copy this to 10-cluster.ini to run Ansible without Terraform.

[control_plane]
10.0.0.10 ansible_user=mora

[worker]
10.0.0.11 ansible_user=mora

[k3s_cluster:children]
control_plane
worker

[all:vars]
ansible_ssh_private_key_file=~/.ssh/id_ed25519
k3s_control_plane_ip=10.0.0.10
k3s_cluster_cidr=11.1.0.0/16
k3s_service_cidr=11.2.0.0/16
cluster_admin_user=mora
cluster_admin_home=/home/mora
